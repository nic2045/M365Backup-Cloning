      },
      "PlanResponse": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/PlanResponse"
      },
      "AuditPage": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/AuditPage"
      },
      "FitCheckResponse": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/FitCheckResponse"
      },
      "Status": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/Status"
      },
      "ReportKind": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/ReportKind"
      },
      "PlanKind": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/PlanKind"
      },
      "AuditEntry": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/AuditEntry"
      },
      "DriftReport": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/DriftReport"
      },
      "Plan": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/Plan"
      },
      "FitCheck": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/FitCheck"
      },
      "Job": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/Job"
      },
      "JobList": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/JobList"
      },
      "JobRequest": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/JobRequest"
      },
      "IntuneBackupList": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/IntuneBackupList"
      },
      "IntuneBackupResponse": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/IntuneBackupResponse"
      },
      "DesiredExportList": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/DesiredExportList"
      },
      "DesiredExportResponse": {
