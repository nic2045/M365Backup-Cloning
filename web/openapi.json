{
  "openapi": "3.1.0",
  "info": {
    "title": "M365Backup-Cloning API",
    "version": "2",
    "description": "API of one toolkit instance (ADR 0002, ADR 0008, ADR 0012). Read routes, and job routes that queue a job and start the job runner in its own process (issue #14). Every route has a schema for its success status and the Error schema for 400, 401, 403 and 500. Every route needs a bearer token of a signed-in person with the app role Reader; Applier and Resetter include Reader (ADR 0010). Starting and cancelling a job also needs the role of its action (x-required-role)."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/reports": {
      "get": {
        "operationId": "listReports",
        "summary": "List drift reports and suitability checks, newest first",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "Reports",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ReportKind"
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/reports/{id}": {
      "get": {
        "operationId": "getReport",
        "summary": "Read one report",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "The report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "File base name below History/reports, e.g. apply-plan-20261107-165032.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/plans": {
      "get": {
        "operationId": "listPlans",
        "summary": "List plans, newest first",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "Plans",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/PlanKind"
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/plans/{id}": {
      "get": {
        "operationId": "getPlan",
        "summary": "Read one plan with its hash",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "The plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "File base name below History/reports, e.g. apply-plan-20261107-165032.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/audit": {
      "get": {
        "operationId": "listAudit",
        "summary": "Read the audit log, newest first, paged",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "Audit entries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "report",
                "plan",
                "apply",
                "refused",
                "reset",
                "fitcheck",
                "backup",
                "setupcheck",
                "export"
              ]
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "planHash",
            "in": "query",
            "required": false,
            "description": "Only the entries of this plan (its SHA-256 plan hash, 64 lowercase hex characters).",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/fitcheck/latest": {
      "get": {
        "operationId": "getLatestFitCheck",
        "summary": "Read the latest suitability check",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "The latest check",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitCheckResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-required-role": "Reader"
      }
    },
    "/api/setup-check/latest": {
      "get": {
        "operationId": "getLatestSetupCheck",
        "summary": "Read the latest setup check",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "The latest setup check",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupCheckResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-required-role": "Reader",
        "description": "The newest read-only setup check of this instance (issue #18). 404 when there is none yet; start one with POST /api/jobs, action setup-check."
      }
    },
    "/api/intune-backups": {
      "get": {
        "operationId": "listIntuneBackups",
        "summary": "List the runs of the Intune backup (issue #68), newest first",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "The runs; files in an older format are listed with state 'outdated'",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntuneBackupList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-required-role": "Reader"
      }
    },
    "/api/intune-backups/{id}": {
      "get": {
        "operationId": "getIntuneBackup",
        "summary": "Read one run of the Intune backup: what changed per tenant since the run before (paths and counts only)",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "The run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntuneBackupResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "File base name below History/reports, e.g. intune-backup-20261107-120000.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/desired-exports": {
      "get": {
        "operationId": "listDesiredExports",
        "summary": "List the exports of the Prod desired state (issue #27), newest first",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "The exports; files in an older format are listed with state 'outdated'",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesiredExportList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-required-role": "Reader"
      }
    },
    "/api/desired-exports/{id}": {
      "get": {
        "operationId": "getDesiredExport",
        "summary": "Read one export of the desired state: what changed since the export before and which resources were not written (paths, names and counts only)",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "The export",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesiredExportResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "File base name below History/reports, e.g. desired-export-20261107-120000.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Read-only status for consumers (ADR 0002 point 8)",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-required-role": "Reader"
      }
    },
    "/api/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List the jobs, newest first (at most 50)",
        "tags": [
          "jobs"
        ],
        "responses": {
          "200": {
            "description": "The jobs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-required-role": "Reader"
      },
      "post": {
        "operationId": "startJob",
        "summary": "Queue a job and start the job runner (preview, report or apply after confirmation)",
        "description": "One job at a time (409 job-running). apply: confirmPlanHash must be the hash of the plan (409 plan-changed); a reset plan also needs confirmTenant, the Dev tenant ID typed by the person (409 tenant-mismatch). Role by action: see src/M365Cloning/Data/WebJobs.json (reset preview and reset apply: Resetter; setup-check with scope Config: Reader, issue #76; all others: Applier).",
        "tags": [
          "jobs"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The queued job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "x-required-role": "Reader|Applier|Resetter"
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Read one job: steps, progress, result and the last log lines",
        "tags": [
          "jobs"
        ],
        "responses": {
          "200": {
            "description": "The job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Job id, e.g. job-20261107-120000-a1b2c3.",
            "schema": {
              "type": "string",
              "pattern": "^job-[0-9]{8}-[0-9]{6}-[a-z0-9]{6}$"
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/jobs/{id}/cancel": {
      "post": {
        "operationId": "cancelJob",
        "summary": "Ask the job to stop before its next step",
        "description": "A running script is not interrupted. Needs the role of the job (409 job-finished when it has ended).",
        "tags": [
          "jobs"
        ],
        "responses": {
          "202": {
            "description": "The job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Job id, e.g. job-20261107-120000-a1b2c3.",
            "schema": {
              "type": "string",
              "pattern": "^job-[0-9]{8}-[0-9]{6}-[a-z0-9]{6}$"
            }
          }
        ],
        "x-required-role": "Reader|Applier|Resetter"
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/Error"
      },
      "ReportList": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/ReportList"
      },
      "ReportResponse": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/ReportResponse"
      },
      "PlanList": {
