      },
      "SetupCheckResponse": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/SetupCheckResponse"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid parameter",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict with the stored data: a file in an older or unknown format ('unsupported-format', issue #59), or for jobs another job still running ('job-running'), a changed plan ('plan-changed'), a typed tenant that is not Dev ('tenant-mismatch'), or a job that has ended ('job-finished').",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No token, or the token is not valid or has expired (codes 'unauthorized', 'invalid-token', 'token-expired', 'sign-in-not-configured').",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Signed in, but without the role this route needs (code 'forbidden').",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Entra ID access token for the API app registration (app roles in the 'roles' claim), or a short-lived token of the local account, accepted only from the loopback address (ADR 0010)."
      }
    }
  }
}
