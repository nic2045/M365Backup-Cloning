{
  "openapi": "3.1.0",
  "info": {
    "title": "M365Backup-Cloning API",
    "version": "2",
    "description": "Read-only API of one toolkit instance (ADR 0002, ADR 0008). Write actions (apply, reset) follow with issue #14. Every route has a schema for 200 and the Error schema for 400, 401, 403 and 500. Every route needs a bearer token of a signed-in person with the app role Reader; Applier and Resetter include Reader (ADR 0010)."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/reports": {
      "get": {
        "operationId": "listReports",
        "summary": "List drift reports and suitability checks, newest first",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "Reports",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ReportKind"
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/reports/{id}": {
      "get": {
        "operationId": "getReport",
        "summary": "Read one report",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "The report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "File base name below History/reports, e.g. apply-plan-20261107-165032.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/plans": {
      "get": {
        "operationId": "listPlans",
        "summary": "List plans, newest first",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "Plans",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/PlanKind"
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/plans/{id}": {
      "get": {
        "operationId": "getPlan",
        "summary": "Read one plan with its hash",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "The plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "File base name below History/reports, e.g. apply-plan-20261107-165032.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/audit": {
      "get": {
        "operationId": "listAudit",
        "summary": "Read the audit log, newest first, paged",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "Audit entries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "report",
                "plan",
                "apply",
                "refused",
                "reset",
                "fitcheck"
              ]
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "planHash",
            "in": "query",
            "required": false,
            "description": "Only the entries of this plan (its SHA-256 plan hash, 64 lowercase hex characters).",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          }
        ],
        "x-required-role": "Reader"
      }
    },
    "/api/fitcheck/latest": {
      "get": {
        "operationId": "getLatestFitCheck",
        "summary": "Read the latest suitability check",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "The latest check",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitCheckResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-required-role": "Reader"
      }
    },
    "/api/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Read-only status for consumers (ADR 0002 point 8)",
        "tags": [
          "read"
        ],
        "responses": {
          "200": {
            "description": "Status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "x-required-role": "Reader"
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/Error"
      },
      "ReportList": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/ReportList"
      },
      "ReportResponse": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/ReportResponse"
      },
      "PlanList": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/PlanList"
      },
      "PlanResponse": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/PlanResponse"
      },
      "AuditPage": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/AuditPage"
      },
      "FitCheckResponse": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/FitCheckResponse"
      },
      "Status": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/Status"
      },
      "ReportKind": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/ReportKind"
      },
      "PlanKind": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/PlanKind"
      },
      "AuditEntry": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/AuditEntry"
      },
      "DriftReport": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/DriftReport"
      },
      "Plan": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/Plan"
      },
      "FitCheck": {
        "$ref": "../schema/m365cloning.schema.json#/$defs/FitCheck"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid parameter",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "The stored file has an older or unknown format; regenerate it with the scripts (code 'unsupported-format', issue #59).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No token, or the token is not valid or has expired (codes 'unauthorized', 'invalid-token', 'token-expired', 'sign-in-not-configured').",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Signed in, but without the role this route needs (code 'forbidden').",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Entra ID access token for the API app registration (app roles in the 'roles' claim), or a short-lived token of the local account, accepted only from the loopback address (ADR 0010)."
      }
    }
  }
}
