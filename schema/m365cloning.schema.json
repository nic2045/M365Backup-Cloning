{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m365cloning.invalid/schema/m365cloning.schema.json",
  "title": "M365Backup-Cloning data contract",
  "description": "Formats written by the core (History/) and the read-only web API (web/openapi.json). See docs/web-contract.md.",
  "$defs": {
    "Difference": {
      "type": "object",
      "required": [
        "Property",
        "Source",
        "Target"
      ],
      "properties": {
        "Property": {
          "type": "string"
        },
        "Source": {
          "type": "string"
        },
        "Target": {
          "type": "string"
        }
      },
      "description": "One property that differs. Values are flattened strings; '<absent>' means the property is missing on that side."
    },
    "DriftReport": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "Kind",
        "CreatedUtc",
        "Direction",
        "Types",
        "Summary",
        "IsIdentical"
      ],
      "properties": {
        "SchemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "Kind": {
          "const": "drift"
        },
        "CreatedUtc": {
          "type": "string",
          "format": "date-time"
        },
        "Direction": {
          "type": "string",
          "description": "Always 'Prod -> Dev' (desired -> actual)."
        },
        "Types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ResourceType",
              "Added",
              "Removed",
              "Changed",
              "Unchanged"
            ],
            "properties": {
              "ResourceType": {
                "type": "string"
              },
              "Added": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "Removed": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "Changed": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "Name",
                    "Differences"
                  ],
                  "properties": {
                    "Name": {
                      "type": "string"
                    },
                    "Differences": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/Difference"
                      }
                    }
                  }
                }
              },
              "Unchanged": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "Summary": {
          "type": "object",
          "required": [
            "Added",
            "Removed",
            "Changed",
            "Unchanged"
          ],
          "properties": {
            "Added": {
              "type": "integer",
              "minimum": 0
            },
            "Removed": {
              "type": "integer",
              "minimum": 0
            },
            "Changed": {
              "type": "integer",
              "minimum": 0
            },
            "Unchanged": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "IsIdentical": {
          "type": "boolean"
        }
      },
      "description": "Drift report as written by Export-DriftReport (History/reports/drift-*.json)."
    },
    "PlanAction": {
      "type": "object",
      "required": [
        "ResourceType",
        "Name",
        "Operation",
        "Status",
        "Reason",
        "DscResource",
        "AssignmentClass",
        "Differences",
        "Properties"
      ],
      "properties": {
        "ResourceType": {
          "type": "string"
        },
        "Name": {
          "type": "string"
        },
        "Operation": {
          "$ref": "#/$defs/PlanOperation"
        },
        "Status": {
          "$ref": "#/$defs/PlanStatus"
        },
        "Reason": {
          "type": "string"
        },
        "DscResource": {
          "type": "string",
          "description": "Microsoft365DSC resource; empty for Graph-based entries."
        },
        "AssignmentClass": {
          "type": "string",
          "description": "Assignment class of the DSC resource; empty when the resource has none."
        },
        "Differences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Difference"
          }
        },
        "Properties": {
          "type": "object",
          "description": "Desired properties (free form, never secrets); an empty object when nothing is written."
        }
      }
    },
    "TypeSummaryEntry": {
      "type": "object",
      "required": [
        "ResourceType",
        "Planned",
        "Blocked",
        "Skipped",
        "Excluded"
      ],
      "properties": {
        "ResourceType": {
          "type": "string"
        },
        "Planned": {
          "type": "integer",
          "minimum": 0
        },
        "Blocked": {
          "type": "integer",
          "minimum": 0
        },
        "Skipped": {
          "type": "integer",
          "minimum": 0
        },
        "Excluded": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PlanSummary": {
      "type": "object",
      "required": [
        "Planned",
        "Blocked",
        "Skipped",
        "Excluded",
        "Exists",
        "Invite",
        "Protected",
        "InBaseline",
        "Devices"
      ],
      "properties": {
        "Planned": {
          "type": "integer",
          "minimum": 0
        },
        "Blocked": {
          "type": "integer",
          "minimum": 0
        },
        "Skipped": {
          "type": "integer",
          "minimum": 0
        },
        "Excluded": {
          "type": "integer",
          "minimum": 0
        },
        "Exists": {
          "type": "integer",
          "minimum": 0
        },
        "Invite": {
          "type": "integer",
          "minimum": 0
        },
        "Protected": {
          "type": "integer",
          "minimum": 0
        },
        "InBaseline": {
          "type": "boolean",
          "description": "True when nothing is planned or blocked (for a baseline plan: the base state is reached)."
        },
        "Devices": {
          "type": "object",
          "required": [
            "Keep",
            "Protected",
            "Remove",
            "Retire",
            "Wipe"
          ],
          "properties": {
            "Keep": {
              "type": "integer",
              "minimum": 0
            },
            "Protected": {
              "type": "integer",
              "minimum": 0
            },
            "Remove": {
              "type": "integer",
              "minimum": 0
            },
            "Retire": {
              "type": "integer",
              "minimum": 0
            },
            "Wipe": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "Device actions of a reset plan; 0 for the other kinds."
        }
      },
      "description": "The same counters for every plan kind (issue #51); a counter a kind does not use is 0.",
      "additionalProperties": false
    },
    "PlanLicences": {
      "type": "object",
      "required": [
        "Checked",
        "Readable",
        "Error",
        "Available",
        "Missing",
        "Warnings"
      ],
      "properties": {
        "Checked": {
          "type": "boolean",
          "description": "False when this plan kind needs no licence check (reset); then Readable is false and Error says why."
        },
        "Readable": {
          "type": "boolean"
        },
        "Error": {
          "type": "string"
        },
        "Available": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Service plan names that are available (sorted)."
        },
        "Missing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Feature",
              "ServicePlans",
              "Source",
              "Entries"
            ],
            "properties": {
              "Feature": {
                "type": "string"
              },
              "ServicePlans": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "Source": {
                "type": "string"
              },
              "Entries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "Warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Licence section of a plan (issue #32): LicenceStatus plus what is missing for which entries. No SKU list: seat counts change and must not change the plan hash.",
      "allOf": [
        {
          "$ref": "#/$defs/LicenceStatus"
        }
      ]
    },
    "Plan": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "Kind",
        "Direction",
        "Title",
        "ApplyHint",
        "Mode",
        "TargetTenant",
        "TargetTenantHash",
        "Actions",
        "Protected",
        "Notes",
        "Summary",
        "TypeSummary",
        "ExcludedTypes",
        "Licences"
      ],
      "properties": {
        "SchemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "Kind": {
          "$ref": "#/$defs/PlanKind"
        },
        "Direction": {
          "type": "string"
        },
        "Title": {
          "type": "string",
          "description": "Empty for apply plans (the Markdown has a default title)."
        },
        "ApplyHint": {
          "type": "string"
        },
        "Mode": {
          "enum": [
            "",
            "Align",
            "Full"
          ],
          "description": "Reset plans: Align or Full; empty for the other kinds."
        },
        "TargetTenant": {
          "type": "string",
          "maxLength": 11,
          "description": "Dev tenant shortened to 8 characters plus '...' (as in the audit log)."
        },
        "TargetTenantHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the Dev tenant ID in lower case. The gate compares it with the Dev tenant of the local config; the plan never carries the full ID."
        },
        "Actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanAction"
          }
        },
        "Protected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Kind",
              "Name",
              "Source"
            ],
            "properties": {
              "Kind": {
                "type": "string"
              },
              "Name": {
                "type": "string"
              },
              "Source": {
                "type": "string"
              },
              "Id": {
                "type": "string",
                "description": "Device entries only: the Intune device ID; the run checks device protection by this ID."
              }
            }
          },
          "description": "Reset plans: the protection list; empty for the other kinds."
        },
        "Notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Summary": {
          "$ref": "#/$defs/PlanSummary"
        },
        "TypeSummary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypeSummaryEntry"
          },
          "description": "Apply plans: counts per resource type; empty for the other kinds."
        },
        "ExcludedTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ResourceType",
              "Reason"
            ],
            "properties": {
              "ResourceType": {
                "type": "string"
              },
              "Reason": {
                "type": "string"
              }
            }
          },
          "description": "Apply plans: excluded resource types; empty for the other kinds."
        },
        "Licences": {
          "$ref": "#/$defs/PlanLicences"
        },
        "Area": {
          "enum": [
            "Intune"
          ],
          "description": "Optional (issue #66): the plan covers one area only. Entries outside it are 'skipped' with a reason starting with 'area:'. Missing: all areas."
        }
      },
      "description": "One plan of any kind (apply, baseline, reset, users) in one shape (schema version 2, issue #51). The plan hash is the SHA-256 of this object; it has no time, so the same tenants give the same hash.",
      "additionalProperties": false
    },
    "PlanFile": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "Kind",
        "CreatedUtc",
        "PlanHash",
        "Plan"
      ],
      "properties": {
        "SchemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "Kind": {
          "$ref": "#/$defs/PlanKind"
        },
        "CreatedUtc": {
          "type": "string",
          "format": "date-time"
        },
        "PlanHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "Plan": {
          "$ref": "#/$defs/Plan"
        }
      },
      "description": "A plan file as written by Export-ApplyPlan (History/reports/<prefix>-<timestamp>.json). Files without SchemaVersion 2 are refused (Read-ApplyPlanFile): make a new plan.",
      "additionalProperties": false
    },
    "PlanKind": {
      "enum": [
        "apply",
        "baseline",
        "reset",
        "users"
      ],
      "description": "Kind of a plan; written into the plan and the plan file (issue #51)."
    },
    "TenantLicences": {
      "type": "object",
      "required": [
        "Checked",
        "Readable",
        "Error",
        "Available",
        "Skus"
      ],
      "properties": {
        "Checked": {
          "type": "boolean",
          "description": "False when this plan kind needs no licence check (reset); then Readable is false and Error says why."
        },
        "Readable": {
          "type": "boolean"
        },
        "Error": {
          "type": "string"
        },
        "Available": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Service plan names that are available (sorted)."
        },
        "Skus": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "SkuPartNumber",
              "CapabilityStatus",
              "AppliesTo",
              "ConsumedUnits",
              "PrepaidEnabled",
              "PrepaidWarning",
              "PrepaidSuspended",
              "PrepaidLockedOut",
              "ServicePlans",
              "ProvidedPlans"
            ],
            "properties": {
              "SkuPartNumber": {
                "type": "string"
              },
              "CapabilityStatus": {
                "type": "string"
              },
              "AppliesTo": {
                "type": "string"
              },
              "ConsumedUnits": {
                "type": "integer",
                "minimum": 0
              },
              "PrepaidEnabled": {
                "type": "integer",
                "minimum": 0
              },
              "PrepaidWarning": {
                "type": "integer",
                "minimum": 0
              },
              "PrepaidSuspended": {
                "type": "integer",
                "minimum": 0
              },
              "PrepaidLockedOut": {
                "type": "integer",
                "minimum": 0
              },
              "ServicePlans": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ProvidedPlans": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/LicenceStatus"
        }
      ],
      "description": "Licences of one tenant in the suitability check (issue #39): LicenceStatus plus the SKU list."
    },
    "FitStatus": {
      "enum": [
        "green",
        "yellow",
        "red",
        "grey"
      ]
    },
    "FitCheck": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "Kind",
        "CreatedUtc",
        "Status",
        "Verified",
        "Verdict",
        "ProdUsageSource",
        "Summary",
        "Findings",
        "Licences"
      ],
      "properties": {
        "SchemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "Kind": {
          "const": "tenantfit"
        },
        "CreatedUtc": {
          "type": "string",
          "format": "date-time"
        },
        "Status": {
          "$ref": "#/$defs/FitStatus"
        },
        "Verified": {
          "type": "boolean"
        },
        "Verdict": {
          "type": "string"
        },
        "ProdUsageSource": {
          "enum": [
            "snapshot",
            "licences",
            "none"
          ]
        },
        "Summary": {
          "type": "object",
          "required": [
            "Red",
            "Yellow",
            "Info",
            "FeaturesUsedInProd",
            "FeaturesMissingInDev"
          ],
          "properties": {
            "Red": {
              "type": "integer",
              "minimum": 0
            },
            "Yellow": {
              "type": "integer",
              "minimum": 0
            },
            "Info": {
              "type": "integer",
              "minimum": 0
            },
            "FeaturesUsedInProd": {
              "type": "integer",
              "minimum": 0
            },
            "FeaturesMissingInDev": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "Findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "Id",
              "Severity",
              "Category",
              "Feature",
              "Message",
              "ServicePlans",
              "AffectedTypes",
              "AffectedCount",
              "Source"
            ],
            "properties": {
              "Id": {
                "type": "string"
              },
              "Severity": {
                "enum": [
                  "red",
                  "yellow",
                  "grey",
                  "info"
                ]
              },
              "Category": {
                "type": "string"
              },
              "Feature": {
                "type": "string"
              },
              "Message": {
                "type": "string"
              },
              "ServicePlans": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "AffectedTypes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "AffectedCount": {
                "type": "integer",
                "minimum": 0
              },
              "Source": {
                "type": "string"
              }
            }
          }
        },
        "Licences": {
          "type": "object",
          "required": [
            "Prod",
            "Dev"
          ],
          "properties": {
            "Prod": {
              "$ref": "#/$defs/TenantLicences"
            },
            "Dev": {
              "$ref": "#/$defs/TenantLicences"
            }
          }
        }
      },
      "description": "Suitability check (issue #39, History/reports/tenantfit-*.json)."
    },
    "AuditEntry": {
      "type": "object",
      "required": [
        "Timestamp",
        "User",
        "Mode",
        "PlanHash",
        "TargetTenant",
        "Counts",
        "Reason"
      ],
      "properties": {
        "Timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "User": {
          "type": "string"
        },
        "Actor": {
          "type": "string",
          "maxLength": 256,
          "description": "Optional: the person signed in to the web interface who started the action (display name, ADR 0010). User stays the account that ran the script."
        },
        "Mode": {
          "enum": [
            "report",
            "plan",
            "apply",
            "refused",
            "reset",
            "fitcheck"
          ]
        },
        "PlanHash": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "TargetTenant": {
          "type": "string",
          "maxLength": 11,
          "description": "Shortened to 8 characters plus '...'."
        },
        "Counts": {
          "type": "object",
          "required": [
            "Planned",
            "Blocked",
            "Skipped",
            "Excluded",
            "Exists",
            "Invite",
            "Protected",
            "Applied",
            "Failed",
            "Deleted",
            "Retired",
            "Wiped",
            "NotRun",
            "Red",
            "Yellow",
            "Info"
          ],
          "properties": {
            "Planned": {
              "type": "integer",
              "minimum": 0
            },
            "Blocked": {
              "type": "integer",
              "minimum": 0
            },
            "Skipped": {
              "type": "integer",
              "minimum": 0
            },
            "Excluded": {
              "type": "integer",
              "minimum": 0
            },
            "Exists": {
              "type": "integer",
              "minimum": 0
            },
            "Invite": {
              "type": "integer",
              "minimum": 0
            },
            "Protected": {
              "type": "integer",
              "minimum": 0
            },
            "Applied": {
              "type": "integer",
              "minimum": 0
            },
            "Failed": {
              "type": "integer",
              "minimum": 0
            },
            "Deleted": {
              "type": "integer",
              "minimum": 0
            },
            "Retired": {
              "type": "integer",
              "minimum": 0
            },
            "Wiped": {
              "type": "integer",
              "minimum": 0
            },
            "NotRun": {
              "type": "integer",
              "minimum": 0
            },
            "Red": {
              "type": "integer",
              "minimum": 0
            },
            "Yellow": {
              "type": "integer",
              "minimum": 0
            },
            "Info": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "description": "The same counters in every line, whatever the mode (issue #51); unused counters are 0."
        },
        "Reason": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false,
      "description": "One line of History/audit.jsonl. Closed set of fields: an audit entry never carries properties, tokens or certificate data."
    },
    "SchemaVersion": {
      "const": "2",
      "description": "Version of the file formats and of this contract (ADR 0008, issue #51). Version 2: every core file carries SchemaVersion and Kind; plans have one shape for all kinds and no full tenant ID."
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ReportKind": {
      "enum": [
        "drift",
        "tenantfit"
      ]
    },
    "ReportListItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "createdUtc"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "$ref": "#/$defs/ReportKind"
        },
        "createdUtc": {
          "type": "string",
          "format": "date-time"
        },
        "isIdentical": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/FitStatus"
        },
        "state": {
          "$ref": "#/$defs/ListItemState"
        }
      }
    },
    "ReportList": {
      "type": "object",
      "required": [
        "schemaVersion",
        "items"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportListItem"
          }
        }
      }
    },
    "ReportResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "kind",
        "createdUtc",
        "report"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "$ref": "#/$defs/ReportKind"
        },
        "createdUtc": {
          "type": "string",
          "format": "date-time"
        },
        "report": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "drift"
              }
            }
          },
          "then": {
            "properties": {
              "report": {
                "$ref": "#/$defs/DriftReport"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tenantfit"
              }
            }
          },
          "then": {
            "properties": {
              "report": {
                "$ref": "#/$defs/FitCheck"
              }
            }
          }
        }
      ]
    },
    "PlanListItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "createdUtc"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "$ref": "#/$defs/PlanKind"
        },
        "createdUtc": {
          "type": "string",
          "format": "date-time"
        },
        "planHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mode": {
          "enum": [
            "Align",
            "Full"
          ]
        },
        "summary": {
          "$ref": "#/$defs/PlanSummary"
        },
        "state": {
          "$ref": "#/$defs/ListItemState"
        },
        "area": {
          "enum": [
            "Intune"
          ],
          "description": "Optional (issue #66): the area of the plan; missing means all areas."
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "outdated"
          }
        },
        "required": [
          "state"
        ]
      },
      "else": {
        "required": [
          "planHash",
          "summary"
        ]
      }
    },
    "PlanList": {
      "type": "object",
      "required": [
        "schemaVersion",
        "items"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanListItem"
          }
        }
      }
    },
    "PlanResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "kind",
        "createdUtc",
        "planHash",
        "plan"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "$ref": "#/$defs/PlanKind"
        },
        "createdUtc": {
          "type": "string",
          "format": "date-time"
        },
        "planHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan": {
          "$ref": "#/$defs/Plan"
        }
      }
    },
    "AuditPage": {
      "type": "object",
      "required": [
        "schemaVersion",
        "items",
        "page",
        "pageSize",
        "total"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuditEntry"
          }
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "FitCheckResponse": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "createdUtc",
        "report"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "createdUtc": {
          "type": "string",
          "format": "date-time"
        },
        "report": {
          "$ref": "#/$defs/FitCheck"
        }
      }
    },
    "Status": {
      "type": "object",
      "required": [
        "schemaVersion",
        "lastComparisonUtc",
        "differences",
        "fitStatus"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "lastComparisonUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Time of the latest drift report; null when there is none."
        },
        "differences": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Added + Removed + Changed of the latest drift report."
        },
        "fitStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/FitStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "reportId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Read-only status for consumers (ADR 0002 point 8). The toolkit does not know its consumers."
    },
    "PlanOperation": {
      "enum": [
        "Create",
        "Update",
        "None",
        "SkipDelete",
        "Delete",
        "Keep",
        "Retire",
        "Wipe",
        "Invite",
        "CreateUser",
        "InviteGuest",
        "AddMember"
      ],
      "description": "What the plan does with an entry (closed list, issue #51). A new operation is added here in the same pull request that introduces it."
    },
    "PlanStatus": {
      "enum": [
        "planned",
        "blocked",
        "skipped",
        "exists",
        "protected",
        "info",
        "applied",
        "failed",
        "not-run",
        "stopped",
        "unchanged",
        "nothing-to-do"
      ],
      "description": "Plan status (planned, blocked, skipped, exists, protected, info) or, in run results, the outcome (applied, failed, not-run, stopped, unchanged, nothing-to-do). Closed list (issue #51)."
    },
    "LicenceStatus": {
      "type": "object",
      "required": [
        "Checked",
        "Readable",
        "Error",
        "Available"
      ],
      "properties": {
        "Checked": {
          "type": "boolean",
          "description": "False when this plan kind needs no licence check (reset); then Readable is false and Error says why."
        },
        "Readable": {
          "type": "boolean"
        },
        "Error": {
          "type": "string"
        },
        "Available": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Service plan names that are available (sorted)."
        }
      },
      "description": "Common core of every licence section (issue #51): the plan check (PlanLicences) and the suitability check (TenantLicences) both start with these fields."
    },
    "ListItemState": {
      "description": "State of a list entry (issue #59). Missing means 'current'. 'outdated': the file has an older or unknown format; only id, kind, mode and the file time are known, and the detail route answers 409 'unsupported-format' (regenerate it with the scripts).",
      "enum": [
        "current",
        "outdated"
      ]
    },
    "JobAction": {
      "enum": [
        "drift",
        "fitcheck",
        "plan-apply",
        "plan-baseline",
        "plan-users",
        "plan-reset",
        "apply"
      ],
      "description": "What a job does (issue #14). drift: drift report; fitcheck: suitability check; plan-*: a preview plan of that kind (changes nothing); apply: applies one plan after the confirmation (reset plans need the role Resetter and a second confirmation)."
    },
    "JobStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "JobStepStatus": {
      "enum": [
        "pending",
        "running",
        "done",
        "failed",
        "skipped"
      ]
    },
    "JobStep": {
      "type": "object",
      "required": [
        "key",
        "title",
        "status"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "$ref": "#/$defs/JobStepStatus"
        }
      },
      "additionalProperties": false
    },
    "JobOptions": {
      "type": "object",
      "properties": {
        "area": {
          "enum": [
            "All",
            "Intune"
          ]
        },
        "mode": {
          "enum": [
            "Align",
            "Full"
          ]
        },
        "deviceAction": {
          "enum": [
            "Keep",
            "Remove",
            "Retire"
          ],
          "description": "Reset plans: one action for all devices. Wipe is not offered in the web interface (script only, ADR 0012)."
        },
        "planId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "planKind": {
          "$ref": "#/$defs/PlanKind"
        },
        "planHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "JobState": {
      "type": "object",
      "required": [
        "id",
        "action",
        "status",
        "role",
        "actor",
        "createdUtc",
        "updatedUtc",
        "startedUtc",
        "finishedUtc",
        "options",
        "steps",
        "message",
        "result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^job-[0-9]{8}-[0-9]{6}-[a-z0-9]{6}$"
        },
        "action": {
          "$ref": "#/$defs/JobAction"
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "role": {
          "enum": [
            "Applier",
            "Resetter"
          ],
          "description": "The role the job needs; also needed to cancel it."
        },
        "actor": {
          "type": "string",
          "maxLength": 256,
          "description": "The person signed in to the web interface who started the job (display name, ADR 0010)."
        },
        "createdUtc": {
          "type": "string",
          "format": "date-time"
        },
        "updatedUtc": {
          "type": "string",
          "format": "date-time"
        },
        "startedUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finishedUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "options": {
          "$ref": "#/$defs/JobOptions"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JobStep"
          }
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "result": {
          "type": "object",
          "properties": {
            "planId": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "planHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reportId": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "exitCode": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "The state of one job as the core keeps it in History/jobs/<id>.json (issue #14). Written by the web API when the job is queued and by the job runner (scripts/Invoke-WebJob.ps1) from then on."
    },
    "JobFile": {
      "type": "object",
      "required": [
        "SchemaVersion",
        "Kind",
        "Job",
        "Confirm"
      ],
      "properties": {
        "SchemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "Kind": {
          "const": "job"
        },
        "Job": {
          "$ref": "#/$defs/JobState"
        },
        "Confirm": {
          "type": "object",
          "properties": {
            "PlanHash": {
              "type": "string",
              "pattern": "^([0-9a-f]{64})?$",
              "description": "apply: the plan hash the person confirmed."
            },
            "TenantHash": {
              "type": "string",
              "pattern": "^([0-9a-f]{64})?$",
              "description": "apply of a reset plan: SHA-256 of the Dev tenant ID the person typed (second confirmation). The typed value itself is never stored."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "File History/jobs/<id>.json. Confirm is never sent by the API."
    },
    "Job": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "action",
        "status",
        "role",
        "actor",
        "createdUtc",
        "updatedUtc",
        "startedUtc",
        "finishedUtc",
        "options",
        "steps",
        "message",
        "result",
        "cancelRequested",
        "progress"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "id": {
          "type": "string",
          "pattern": "^job-[0-9]{8}-[0-9]{6}-[a-z0-9]{6}$"
        },
        "action": {
          "$ref": "#/$defs/JobAction"
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "role": {
          "enum": [
            "Applier",
            "Resetter"
          ],
          "description": "The role the job needs; also needed to cancel it."
        },
        "actor": {
          "type": "string",
          "maxLength": 256,
          "description": "The person signed in to the web interface who started the job (display name, ADR 0010)."
        },
        "createdUtc": {
          "type": "string",
          "format": "date-time"
        },
        "updatedUtc": {
          "type": "string",
          "format": "date-time"
        },
        "startedUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finishedUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "options": {
          "$ref": "#/$defs/JobOptions"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JobStep"
          }
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "result": {
          "type": "object",
          "properties": {
            "planId": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "planHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reportId": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "exitCode": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "progress": {
          "type": "object",
          "required": [
            "done",
            "total"
          ],
          "properties": {
            "done": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "log": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 200,
          "description": "Detail only: the last lines of the job log (GUIDs masked)."
        }
      },
      "additionalProperties": false,
      "description": "A job as the API returns it (issue #14): the job state plus progress (steps done of all steps) and, in the detail, the last log lines."
    },
    "JobList": {
      "type": "object",
      "required": [
        "schemaVersion",
        "items"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Job"
          }
        }
      }
    },
    "JobRequest": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/JobAction"
        },
        "area": {
          "enum": [
            "All",
            "Intune"
          ],
          "description": "plan-apply only; default All."
        },
        "mode": {
          "enum": [
            "Align",
            "Full"
          ],
          "description": "plan-reset only; default Align."
        },
        "deviceAction": {
          "enum": [
            "Keep",
            "Remove",
            "Retire"
          ],
          "description": "plan-reset only; default Keep."
        },
        "planId": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,100}$",
          "description": "apply only: the plan to apply."
        },
        "confirmPlanHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "apply only: the hash of the plan the person looked at (first confirmation)."
        },
        "confirmTenant": {
          "type": "string",
          "maxLength": 100,
          "description": "apply of a reset plan only: the Dev tenant ID typed by the person (second confirmation). Never stored, only its hash."
        }
      },
      "additionalProperties": false,
      "description": "Body of POST /api/jobs (issue #14)."
    }
  }
}
